<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect /index.html and /index at root to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?\ HTTP/ [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # 2. Redirect /blog/index.html and /blog/index to /blog
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog/index(\.html)?\ HTTP/ [NC]
  RewriteRule ^blog/index(\.html)?$ /blog [R=301,L]

  # 3. Redirect /paket/index.html and /paket/index to /paket
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /paket/index(\.html)?\ HTTP/ [NC]
  RewriteRule ^paket/index(\.html)?$ /paket [R=301,L]

  # 4. Redirect any other folder /.../index.html or /.../index to /...
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index(\.html)?\ HTTP/ [NC]
  RewriteRule ^(.*)/index(\.html)?$ /$1 [R=301,L]

  # 5. Route /blog, /paket, and /penulis cleanly
  RewriteRule ^blog/?$ blog.html [L]
  RewriteRule ^paket/?$ paket.html [L]
  RewriteRule ^penulis/?$ penulis.html [L]
  RewriteRule ^author/?$ penulis.html [L]
  RewriteRule ^author/yudi-abraham/?$ /penulis.html [R=301,L]

  # 6. Redirect renamed paket pages
  RewriteRule ^paket/souvenir-pernikahan(\.html)?$ /paket/souvenir-tradisional.html [R=301,L]
  RewriteRule ^paket/souvenir-perusahaan(\.html)?$ /paket/souvenir-modern.html [R=301,L]
</IfModule>

# ------------------------------------------------------------
# 7. Proteksi Server: Blokir Akses Langsung ke Berkas Sensitif & Hidden Dirs
# ------------------------------------------------------------
<FilesMatch "(^#.*#|\.(md|json|map|env|sql|db|sqlite|log|bak|backup|old|temp|tmp|sh|bat|ps1|cmd|git.*))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  # Blokir akses langsung ke direktori titik (.git, .agents, dll) kecuali .well-known
  RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>
