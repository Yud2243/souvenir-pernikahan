{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/index",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/paket/index.html",
      "destination": "/paket",
      "permanent": true
    },
    {
      "source": "/paket/index",
      "destination": "/paket",
      "permanent": true
    },
    {
      "source": "/paket/souvenir-pernikahan.html",
      "destination": "/paket/souvenir-tradisional",
      "permanent": true
    },
    {
      "source": "/paket/souvenir-pernikahan",
      "destination": "/paket/souvenir-tradisional",
      "permanent": true
    },
    {
      "source": "/paket/souvenir-perusahaan.html",
      "destination": "/paket/souvenir-modern",
      "permanent": true
    },
    {
      "source": "/paket/souvenir-perusahaan",
      "destination": "/paket/souvenir-modern",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:path*/index",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/PRD-Greens-Souvenir.md",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/design.md",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/paket",
      "destination": "/paket.html"
    },
    {
      "source": "/tentang",
      "destination": "/tentang.html"
    },
    {
      "source": "/portofolio",
      "destination": "/portofolio.html"
    },
    {
      "source": "/penulis",
      "destination": "/penulis.html"
    },
    {
      "source": "/kebijakan-privasi",
      "destination": "/kebijakan-privasi.html"
    },
    {
      "source": "/detail-portofolio",
      "destination": "/detail-portofolio.html"
    }
  ]
}
